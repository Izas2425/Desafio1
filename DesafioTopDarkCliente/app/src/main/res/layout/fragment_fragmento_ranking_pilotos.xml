<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.FragmentoRankingPilotos">

    <ImageView
        android:id="@+id/imFondoRankingP"
        android:layout_width="414dp"
        android:layout_height="738dp"
        android:src="@drawable/piloto_fondo_vader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaRankingPRecycler"
        android:layout_width="411dp"
        android:layout_height="565dp"
        app:layout_constraintBottom_toBottomOf="@+id/imFondoRankingP"
        app:layout_constraintEnd_toEndOf="@+id/imFondoRankingP"
        app:layout_constraintHorizontal_bias="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.293" />
</androidx.constraintlayout.widget.ConstraintLayout>